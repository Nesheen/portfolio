---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Quien from "../components/Quien.astro";
import Proyectos from "../components/Proyectos.astro";
import Recorrido from "../components/Recorrido.astro";
import Socrates from "../components/Socrates.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main id="top">
    <div class="wrap">
      <Hero />
      <Quien />
      <Proyectos />
      <Recorrido />
      <Socrates />
      <Contacto />
    </div>
  </main>
  <Footer />
</Base>
