---
// Columna jónica cuyo fuste es un rack de servidores. Hover/foco en una bahía la ilumina.
const bahias = Array.from({ length: 8 }, (_, i) => {
  const y = 108 + i * 42;
  return {
    y,
    borde: `M${66 + i * 0.7} ${y} H${194 - i * 0.7}`,
    lineas: `M86 ${y + 14} H140 M86 ${y + 20} H128`,
    delay: 0.6 + i * 0.06,
  };
});
---

<figure class="fig">
  <svg class="columna" viewBox="0 0 260 540" role="img" aria-label="Columna griega dibujada en línea, con el fuste convertido en un rack de servidores">
    <g>
      <rect class="t capitel" pathLength="1" x="18" y="20" width="224" height="16" style="animation-delay:.05s" />
      <path class="t capitel" pathLength="1" d="M40 36 H220 M40 50 H220" style="animation-delay:.15s" />
      <path class="t capitel" pathLength="1" d="M48 36 C14 34 8 74 34 84 C56 92 66 62 48 58 C36 55 34 72 44 72" style="animation-delay:.25s" />
      <path class="t capitel" pathLength="1" d="M212 36 C246 34 252 74 226 84 C204 92 194 62 212 58 C224 55 226 72 216 72" style="animation-delay:.25s" />
      <path class="t capitel fino" pathLength="1" d="M70 58 Q130 76 190 58 M78 66 Q130 82 182 66" style="animation-delay:.4s" />
      <rect class="t capitel" pathLength="1" x="58" y="84" width="144" height="10" style="animation-delay:.45s" />
    </g>
    <g>
      <path class="t" pathLength="1" d="M64 94 L70 446 M196 94 L190 446" style="animation-delay:.5s" />
      <path class="t fino" pathLength="1" d="M168 98 L166 442 M176 98 L174 442 M184 98 L182 442" style="animation-delay:.7s" />
    </g>
    <g>
      {bahias.map((b, i) => (
        <g class="bahia" tabindex="0" aria-label={`Unidad ${i + 1}`}>
          <path class="t" pathLength="1" d={b.borde} style={`animation-delay:${b.delay}s`} />
          <path class="t fino" pathLength="1" d={b.lineas} style={`animation-delay:${b.delay + 0.15}s`} />
          <circle class="led" cx="152" cy={b.y + 17} r="3.2" />
          <circle class="led" cx="162" cy={b.y + 17} r="3.2" />
        </g>
      ))}
    </g>
    <g>
      <path class="t basa" pathLength="1" d="M60 446 H200" style="animation-delay:1s" />
      <path class="t basa" pathLength="1" d="M52 446 C40 452 40 466 52 470 H208 C220 466 220 452 208 446" style="animation-delay:1.05s" />
      <path class="t basa" pathLength="1" d="M44 470 C30 476 30 492 44 496 H216 C230 492 230 476 216 470" style="animation-delay:1.15s" />
      <rect class="t basa" pathLength="1" x="24" y="496" width="212" height="22" style="animation-delay:1.25s" />
      <path class="t fino basa" pathLength="1" d="M30 504 h8 M44 510 h10 M200 504 h12 M188 510 h6" style="animation-delay:1.35s" />
    </g>
  </svg>
  <figcaption>Pasá el mouse por el fuste.</figcaption>
</figure>

<style>
  .fig{margin:0}
  .columna{width:100%; max-width:300px; display:block; margin:0 auto; overflow:visible}
  .t{fill:none; stroke:var(--crema); stroke-width:1.4; stroke-linecap:round; stroke-linejoin:round;
    stroke-dasharray:1; stroke-dashoffset:1; animation:trazar 1.6s cubic-bezier(.6,.1,.3,1) forwards}
  .t.fino{stroke-width:.8; opacity:.7}
  .t.capitel{stroke:var(--sol)}
  .t.basa{stroke:var(--fuego)}
  .led{fill:var(--selva); stroke:var(--selva); stroke-width:1; animation:latido 2.4s ease-in-out infinite; transition:filter .3s}
  .bahia:nth-child(2n) .led{animation-delay:.8s; fill:var(--sol); stroke:var(--sol)}
  .bahia:nth-child(3n) .led{animation-delay:1.5s; fill:var(--cielo); stroke:var(--cielo)}
  .bahia{outline:none; cursor:default}
  .bahia:hover .led, .bahia:focus-visible .led{animation:none; opacity:1; filter:drop-shadow(0 0 4px currentColor) brightness(1.4)}
  .bahia:hover .t, .bahia:focus-visible .t{stroke:var(--sol)}
  figcaption{font-size:13px; text-align:center; opacity:.7; margin-top:6px}
  @keyframes trazar{to{stroke-dashoffset:0}}
  @keyframes latido{50%{opacity:.35}}
  @media (max-width:900px){
    .columna{max-width:200px; margin:0}
    figcaption{text-align:left}
  }
  @media (prefers-reduced-motion:reduce){ .t{stroke-dashoffset:0} }
</style>
