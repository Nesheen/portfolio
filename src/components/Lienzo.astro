---
// Fondo pintado: hojas de colores en los bordes, viñeta oscura en el centro.
// Se genera en el build con un random con semilla, así sale siempre igual.
const colores = ["#1F9D62", "#0F6B43", "#2BBF7A", "#FF6A2B", "#F7C548", "#4A92FF", "#C2401A", "#145A3A"];
let s = 42;
const r = () => (s = (s * 16807) % 2147483647) / 2147483647;

const hojas = Array.from({ length: 70 }, (_, i) => {
  let x: number, y: number;
  if (r() < 0.5) { x = r() < 0.5 ? r() * 320 : 1280 + r() * 320; y = r() * 1000; }
  else { x = r() * 1600; y = r() < 0.5 ? r() * 200 : 800 + r() * 200; }
  const esc = 0.8 + r() * 2.4, rot = r() * 360;
  return { transform: `translate(${x} ${y}) rotate(${rot}) scale(${esc})`, color: colores[i % colores.length] };
});
---

<div class="lienzo" aria-hidden="true">
  <svg preserveAspectRatio="xMidYMid slice" viewBox="0 0 1600 1000">
    <defs>
      <filter id="pincel" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency=".012" numOctaves="3" seed="7" />
        <feDisplacementMap in="SourceGraphic" scale="60" />
      </filter>
      <radialGradient id="vineta" cx="50%" cy="50%" r="60%">
        <stop offset=".35" stop-color="#08113A" stop-opacity=".94" />
        <stop offset="1" stop-color="#08113A" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="1600" height="1000" fill="#0B1A4A" />
    <g filter="url(#pincel)">
      <circle cx="1380" cy="160" r="170" fill="#FF6A2B" opacity=".55" />
      <circle cx="200" cy="880" r="220" fill="#4A92FF" opacity=".45" />
      {hojas.map((h) => (
        <g transform={h.transform}>
          <path d="M0 0 C25 -32 70 -30 100 0 C70 30 25 32 0 0 Z" fill={h.color} opacity=".9" />
          <path d="M0 0 H96" stroke="#08113A" stroke-width="1.2" opacity=".5" fill="none" />
        </g>
      ))}
    </g>
    <rect width="1600" height="1000" fill="url(#vineta)" />
  </svg>
</div>

<style>
  .lienzo{position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; animation:aparecer .9s ease both}
  .lienzo svg{width:100%; height:100%}
  @keyframes aparecer{from{opacity:0}}
</style>
