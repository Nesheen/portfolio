---
import Columna from "./Columna.astro";
import { perfil } from "../data/perfil";
---

<div class="hero">
  <div>
    <h1><span>{perfil.nombre}</span><span>{perfil.apellido}</span></h1>
    <p class="bajada">{perfil.bajada}</p>
    <div class="acciones">
      <a class="btn btn-lleno" href="#proyectos">Ver proyectos</a>
      <a class="btn" href="#contacto">Escribirme</a>
    </div>
  </div>
  <Columna />
</div>

<div class="meandro" aria-hidden="true">
  <svg preserveAspectRatio="none">
    <defs>
      <pattern id="greca" width="44" height="22" patternUnits="userSpaceOnUse">
        <path d="M0 21 H44 M2 21 V3 H20 V15 H10 V9 M24 21 V3 H42 V15 H32 V9" fill="none" stroke="currentColor" stroke-width="1.4" />
      </pattern>
    </defs>
    <rect width="100%" height="22" fill="url(#greca)" />
  </svg>
</div>

<style>
  .hero{display:grid; grid-template-columns:1.25fr .75fr; gap:40px; align-items:center; min-height:min(88vh,860px); padding:48px 0 24px}
  h1{font-family:var(--display); font-weight:400; margin:0; font-size:clamp(64px, 11vw, 168px); line-height:.86; letter-spacing:-.025em}
  h1 span{display:block}
  h1 span:last-child{padding-left:.42em; color:var(--sol)}
  .bajada{max-width:30ch; font-size:clamp(19px,1.8vw,23px); line-height:1.4; margin:36px 0 32px}
  .acciones{display:flex; flex-wrap:wrap; gap:14px}
  .meandro{height:22px; color:var(--sol); opacity:.85; margin:32px 0 0}
  .meandro svg{width:100%; height:22px; display:block}
  @media (max-width:900px){
    .hero{grid-template-columns:1fr; min-height:auto; padding-top:32px}
  }
</style>
