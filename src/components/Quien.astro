---
import { perfil } from "../data/perfil";
const nombreCompleto = `${perfil.nombre} ${perfil.apellido}`;
---

<section id="quien" aria-labelledby="t-quien">
  <div class="sec-head">
    <span class="sec-num">Quién</span>
    <h2 id="t-quien">Un perfil de punta a punta.</h2>
  </div>
  <div class="quien">
    <div>
      <button class="id" id="idcard" type="button" aria-pressed="false" aria-label="Credencial de desarrollador. Activá para darla vuelta.">
        <div class="id-in">
          <div class="cara">
            <div class="id-top"><span>Developer ID</span><span>NB-2026</span></div>
            <div class="id-cuerpo">
              <div class="id-retrato" aria-hidden="true">
                <!-- TODO: reemplazar por retrato propio en dibujo de línea -->
                <svg viewBox="0 0 60 80"><path d="M30 10c-9 0-15 7-15 17 0 7 3 12 7 15v6c-9 2-16 8-17 22h50c-1-14-8-20-17-22v-6c4-3 7-8 7-15 0-10-6-17-15-17Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
              </div>
              <div>
                <p class="id-nombre">{nombreCompleto}</p>
                <p class="id-rol">{perfil.rol}</p>
                <dl class="id-datos">
                  <dt>Base</dt><dd>{perfil.base}</dd>
                  <dt>Título</dt><dd>{perfil.titulo}</dd>
                  <dt>Idiomas</dt><dd>{perfil.idiomas}</dd>
                </dl>
              </div>
            </div>
          </div>
          <div class="cara cara-dorso">
            <div class="id-top"><span>En corto</span><span>NB-2026</span></div>
            <ul class="dorso-lista">
              {perfil.enCorto.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </button>
      <p class="id-ayuda">Hacé clic o apretá Enter para darla vuelta.</p>
    </div>
    <div class="quien-texto">
      {perfil.quien.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<script>
  const id = document.getElementById("idcard")!;
  id.addEventListener("click", () => id.setAttribute("aria-pressed", String(id.getAttribute("aria-pressed") !== "true")));
</script>

<style>
  .quien{display:grid; grid-template-columns:minmax(300px,420px) 1fr; gap:64px; align-items:start}
  .quien-texto p{max-width:56ch; margin:0 0 1.1em}
  .quien-texto p:first-child{font-family:var(--display); font-size:clamp(26px,2.6vw,34px); line-height:1.2}

  .id{perspective:1200px; cursor:pointer; background:none; border:0; padding:0; text-align:left; color:inherit; font:inherit; width:100%}
  .id-in{position:relative; aspect-ratio:1.586/1; transform-style:preserve-3d; transition:transform .8s cubic-bezier(.3,.7,.2,1)}
  .id[aria-pressed="true"] .id-in{transform:rotateY(180deg)}
  .cara{
    position:absolute; inset:0; backface-visibility:hidden; -webkit-backface-visibility:hidden;
    border:1.5px solid var(--sol); border-radius:14px; padding:20px 22px;
    background:var(--panel); backdrop-filter:blur(6px);
    display:flex; flex-direction:column; overflow:hidden;
  }
  .cara::after{ /* trama de guilloché */
    content:""; position:absolute; inset:0; pointer-events:none; opacity:.14;
    background:repeating-radial-gradient(circle at 85% 110%, var(--sol) 0 1px, transparent 1px 7px);
  }
  .cara-dorso{transform:rotateY(180deg)}
  .id-top{display:flex; justify-content:space-between; font-size:13px; font-weight:600; letter-spacing:.02em; color:var(--sol)}
  .id-cuerpo{display:flex; gap:18px; margin-top:auto; align-items:flex-end}
  .id-retrato{width:30%; aspect-ratio:3/4; border:1px solid var(--fg); border-radius:6px; display:grid; place-items:center; flex:none}
  .id-retrato svg{width:70%}
  .id-nombre{font-family:var(--display); font-size:clamp(22px,2.2vw,28px); line-height:1.05; margin:0 0 4px}
  .id-rol{font-size:14px; margin:0 0 12px; color:var(--fg-2)}
  .id-datos{display:grid; grid-template-columns:auto 1fr; gap:2px 14px; font-size:13px; margin:0}
  .id-datos dt{color:var(--fg-2)}
  .id-datos dd{margin:0; font-weight:500}
  .dorso-lista{list-style:none; margin:14px 0 0; padding:0; font-size:14px; line-height:1.4; display:grid; gap:7px; position:relative; z-index:1}
  .dorso-lista li{padding-left:16px; position:relative}
  .dorso-lista li::before{content:""; position:absolute; left:0; top:.55em; width:7px; height:7px; border-radius:50%; background:var(--selva)}
  .id-ayuda{font-size:13px; color:var(--fg-2); margin-top:12px}

  @media (max-width:900px){
    .quien{grid-template-columns:1fr; gap:40px}
  }
  @media (max-width:420px){
    .dorso-lista{font-size:12.5px; gap:4px}
    .cara{padding:14px 16px}
  }
</style>
